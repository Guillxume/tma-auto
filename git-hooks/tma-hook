#!/bin/sh
# Hooks git de l'agent. tma-auto impose core.hooksPath=<ce dossier> à chaque commande git de
# l'agent (variables GIT_CONFIG_*), ce qui remplace la protection de branche absente du plan
# GitHub Free.
#   pre-push : seule refs/heads/$TMA_ALLOWED_BRANCH peut être poussée, et aucune suppression.
# Le hook propre au dépôt (husky ou .git/hooks) est ensuite rejoué s'il existe.
hook=$1
shift

input=""
if [ "$hook" = pre-push ]; then
  input=$(cat)
  printf '%s\n' "$input" | while read -r _lref lsha rref _rsha; do
    [ -z "$rref" ] && continue
    if [ -z "${TMA_ALLOWED_BRANCH:-}" ] || [ "$rref" != "refs/heads/$TMA_ALLOWED_BRANCH" ]; then
      echo "tma-auto : push refusé vers $rref. Seule la branche ${TMA_ALLOWED_BRANCH:-<aucune>} est autorisée." >&2
      exit 1
    fi
    case "$lsha" in
      0000000*) echo "tma-auto : suppression de branche refusée." >&2; exit 1 ;;
    esac
  done || exit 1
fi

[ "${HUSKY:-1}" = 0 ] && exit 0
top=$(git rev-parse --show-toplevel 2>/dev/null)
common=$(git rev-parse --git-common-dir 2>/dev/null)
for candidate in "$top/.husky/_/$hook" "$common/hooks/$hook"; do
  if [ -x "$candidate" ]; then
    if [ "$hook" = pre-push ]; then printf '%s\n' "$input" | "$candidate" "$@"; else "$candidate" "$@"; fi
    exit $?
  fi
done
exit 0
