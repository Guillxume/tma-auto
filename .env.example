# --- Serveur ---
# Plafonds du conteneur (le serveur peut aussi héberger des boutiques en production)
TMA_MEM_LIMIT=3g
TMA_CPUS=1.5
# Sous-domaine servi par Traefik (compose.yml)
TMA_HOST=tma.example.com
# HOST=127.0.0.1
PORT=8787
WEBHOOK_PATH=/webhooks/linear

# Mot de passe du tableau de bord https://<TMA_HOST>/dashboard (vide = désactivé)
TMA_DASHBOARD_PASSWORD=

# --- Linear ---
# Secret de signature affiché à la création du webhook
LINEAR_WEBHOOK_SECRET=lin_wh_xxxxxxxxxxxxxxxx
# Ton ID utilisateur Linear (UUID, visible dans l'API ou l'URL de ton profil)
LINEAR_ASSIGNEE_ID=00000000-0000-0000-0000-000000000000
# Clé API personnelle Linear : commentaires de suivi + commande /tma (requise)
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxx
# Vide = dès qu'un ticket t'est assigné. Renseigné = il faut aussi ce label.
REQUIRED_LABEL=
# Commentaire qui relance l'agent avec ta décision : "/tma option 2"
COMMENT_COMMAND=/tma
# Autres personnes autorisées à relancer par /tma (IDs Linear, séparés par des virgules)
TMA_TRUSTED_USERS=

# --- Slack (quand l'agent coince ou a besoin d'un arbitrage) ---
# Option A (recommandée) : message privé via une app Slack
SLACK_BOT_TOKEN=xoxb-xxxxxxxx
SLACK_USER_ID=U0XXXXXXX
# Option B : webhook entrant vers un canal (prioritaire si renseigné)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- GitHub ---
# Compte bot qui pousse les branches et ouvre les PR (scripts/setup.sh)
GITHUB_BOT_LOGIN=acme-tma-bot
GITHUB_BOT_EMAIL=acme-tma-bot@users.noreply.github.com
# Fine-grained PAT du bot : Contents + Pull requests en écriture, dépôts de repos.json + tma-knowledge
GITHUB_BOT_TOKEN=github_pat_xxxxxxxx
# Secret du webhook GitHub (relances « @tma » depuis une relecture de PR) : scripts/github-webhook.sh
GITHUB_WEBHOOK_SECRET=
# Autres logins GitHub autorisés à relancer par @tma (en plus du reviewer)
TMA_TRUSTED_GITHUB=
# Login GitHub qui sera demandé en reviewer
GITHUB_REVIEWER=your-github-login
# PAT *classic* du bot, scope read:packages uniquement : installe @acme/internal-ui
NODE_AUTH_TOKEN=ghp_xxxxxxxx

# --- Claude Code ---
# Une des deux : clé API (recommandé pour un serveur) OU token issu de `claude setup-token`
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxx
CLAUDE_BIN=claude
# CLAUDE_MODEL=opus
MAX_BUDGET_USD=5
JOB_TIMEOUT_MIN=30

# --- Mission audit-rgaa (audit d'accessibilité de la recette, rapport en Artifact) ---
# AUDIT_MODEL=opus            (défaut : CLAUDE_MODEL)
# AUDIT_BUDGET_USD=40
# AUDIT_TIMEOUT_MIN=150
# UTILITY_MODEL=haiku         (qualification des tickets, publication du rapport)
# DEV_HOURLY_RATE=50          (€/h d'un développeur : valorise l'« équivalent humain » du tableau de bord)
# ARTIFACT_PUBLISH=0          (rapport servi par tma-auto sur /audits/… au lieu d'un Artifact claude.ai)

# --- Recettes : identifiant et mot de passe (HTTP) pour l'audit d'accessibilité (/tma recette, mission audit-rgaa) ---
# RECETTE_AUTH=identifiant:motdepasse   (commun à toutes les recettes)
# RECETTE_AUTH_GLOBEX=identifiant:motdepasse   (exception par site)

# --- Bases de RECETTE uniquement (lecture seule, utilisateur tma_ro), via tunnel SSH ---
# DB_URL_GLOBEX=mysql://tma_ro:<mdp>@<hôte du tunnel>:<port>/globex
# DB_URL_GLOBEX_PT=mysql://tma_ro:<mdp>@<hôte du tunnel>:<port>/globex-pt

# --- Chemins : uniquement pour la variante VPS (en Docker, le Dockerfile et compose.yml les fixent) ---
# REPOS_FILE=/home/tma/tma-auto/repos.json
# WORKTREES_DIR=/home/tma/tma-worktrees
# LOGS_DIR=/home/tma/tma-auto/logs
# STATE_DIR=/home/tma/tma-auto/state
# Clone de acme/tma-knowledge (skills + journal)
# KNOWLEDGE_DIR=/home/tma/tma-knowledge
# KNOWLEDGE_REPO=acme/tma-knowledge
# Modules maison (auteur ou nom), modifiables par l'agent : inventaire hebdomadaire de scripts/sync-knowledge.mjs
# IN_HOUSE_MODULES=^acme

# 1 = n'exécute ni git ni Claude, affiche seulement le prompt
DRY_RUN=0
